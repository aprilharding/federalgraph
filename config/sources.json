{
  "sources": {
    "usagov": {
      "enabled": true,
      "kind": "organization_directory",
      "authority": "official",
      "base_url": "https://www.usa.gov/agency-index",
      "letters": "abcdefghijklmnopqrstuvwxyz",
      "timeout_seconds": 45
    },
    "federal_register": {
      "enabled": true,
      "kind": "organization_directory",
      "authority": "official",
      "endpoint": "https://www.federalregister.gov/api/v1/agencies.json",
      "timeout_seconds": 45
    },
    "fpi": {
      "enabled": true,
      "kind": "program_inventory",
      "authority": "official"
    },
    "govinfo_govman": {
      "enabled": true,
      "kind": "organization_directory",
      "authority": "canonical_name",
      "package_id": "GOVMAN-2025-12-31",
      "xml_url": "https://www.govinfo.gov/content/pkg/GOVMAN-2025-12-31/xml/GOVMAN-2025-12-31.xml",
      "publication_date": "2025-12-31",
      "timeout_seconds": 120,
      "notes": "Authoritative canonical organization name when an entity appears in the U.S. Government Manual.",
      "context_url": "https://www.govinfo.gov/app/details/GOVMAN-2025-12-31/context",
      "workers": 12,
      "api_base_url": "https://api.govinfo.gov",
      "api_key_env": "GOVINFO_API_KEY",
      "api_key_fallback": "DEMO_KEY",
      "api_page_size": 100
    },
    "opm_fwd": {
      "enabled": true,
      "kind": "workforce_organization_hierarchy",
      "authority": "official",
      "files_api": "https://data.opm.gov/api/v1/files/employment",
      "download_base_url": "https://data.opm.gov/api/v1/files/employment",
      "timeout_seconds": 180,
      "notes": "Official OPM/EHRI workforce department, agency, and subagency names/codes. Fallback naming authority only when GovInfo is absent.",
      "selection": "current_latest"
    }
  },
  "resolution": {
    "auto_merge_threshold": 96,
    "review_threshold": 88,
    "hierarchy_threshold": 80
  },
  "name_authority": {
    "authoritative_source": "govinfo_govman",
    "fallback_order": [
      "opm_fwd",
      "federal_register",
      "usagov"
    ],
    "emit_review_when_fallback_names_disagree": true
  }
